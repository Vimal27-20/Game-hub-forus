# Copy to .env (never commit .env). All optional for local LAN play.
PORT=3000
# Public HTTPS base URL when hosted; used for join links and QR codes.
PUBLIC_URL=
# Comma-separated CORS origins for the API and socket (default *).
ALLOWED_ORIGINS=*
# Build-time: the hub the store TV apps connect to.
HUDDLE_SERVER_URL=
